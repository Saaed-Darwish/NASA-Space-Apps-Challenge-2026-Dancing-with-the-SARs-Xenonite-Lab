# Ollama locally; switch these three values for a hosted chat-completions provider.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=ministral-3:3b
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
# Explicit trusted frontend origins for API writes, including reverse-proxy deployments.
# Origin checks protect browser requests; they do not replace deployment authentication.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
